<!DOCTYPE html>
<html>
<head>
    <title>HTML Lists Example</title>
</head>
<body>
    <h1>HTML Lists Demonstration</h1>

    <!-- Ordered List -->
    <h2>Ordered List (క్రమానుసారంగా)</h2>
    <ol>
        <li>Apple</li>
        <li>Banana</li>
        <li>Cherry</li>
    </ol>

    <!-- Unordered List -->
    <h2>Unordered List (క్రమం అవసరం లేదు)</h2>
    <ul>
        <li>Dog</li>
        <li>Cat</li>
        <li>Rabbit</li>
    </ul>

    <!-- Nested Lists -->
    <h2>Nested List (అంతర్గత లిస్ట్)</h2>
    <ul>
        <li>Fruits
            <ul>
                <li>Apple</li>
                <li>Banana</li>
                <li>Cherry</li>
            </ul>
        </li>
        <li>Vegetables
            <ul>
                <li>Carrot</li>
                <li>Tomato</li>
                <li>Potato</li>
            </ul>
        </li>
    </ul>

    <!-- Ordered List inside an Unordered List -->
    <h2>Ordered List inside an Unordered List</h2>
    <ul>
        <li>Steps to make Tea:
            <ol>
                <li>Boil water</li>
                <li>Add tea leaves</li>
                <li>Add sugar & milk</li>
                <li>Serve hot</li>
            </ol>
        </li>
    </ul>

    <!-- Definition List -->
    <h2>Definition List</h2>
    <dl>
        <dt>HTML</dt>
        <dd>Hyper Text Markup Language</dd>
        <dt>CSS</dt>
        <dd>Cascading Style Sheets</dd>
        <dt>JS</dt>
        <dd>JavaScript Programming Language</dd>
    </dl>

</body>
</html>
