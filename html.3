<!DOCTYPE html>
<html>
<head>
    <title>Profile Images Example</title>
</head>
<body>
    <h1>My Profile and My Friend's Profile</h1>

    <!-- My Image -->
    <h2>My Profile</h2>
    <a href="https://www.linkedin.com/in/myprofile" target="_blank">
        <img src="myphoto.jpg" alt="My Photo" width="200" height="200">
    </a>
    <p>Click on the image to visit my profile.</p>

    <!-- Friend's Image -->
    <h2>My Friend's Profile</h2>
    <a href="https://www.linkedin.com/in/friendprofile" target="_blank">
        <img src="friendphoto.jpg" alt="Friend Photo" width="200" height="200">
    </a>
    <p>Click on the image to visit my friend's profile.</p>

</body>
</html>
