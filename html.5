<!DOCTYPE html>
<html>
<head>
    <title>HTML Tables Example</title>
</head>
<body>
    <h1>HTML Tables Demonstration</h1>

    <!-- Simple Table with border -->
    <h2>Simple Table</h2>
    <table border="2" cellpadding="10" cellspacing="0">
        <tr>
            <th>Sr. No</th>
            <th>Name</th>
            <th>Age</th>
            <th>City</th>
        </tr>
        <tr>
            <td>1</td>
            <td>Ravi</td>
            <td>25</td>
            <td>Hyderabad</td>
        </tr>
        <tr>
            <td>2</td>
            <td>Sita</td>
            <td>22</td>
            <td>Bangalore</td>
        </tr>
        <tr>
            <td>3</td>
            <td>Arjun</td>
            <td>28</td>
            <td>Chennai</td>
        </tr>
    </table>

    <!-- Table with colspan and rowspan -->
    <h2>Table with Rowspan and Colspan</h2>
    <table border="2" cellpadding="10" cellspacing="0">
        <tr>
            <th>Student</th>
            <th colspan="2">Subjects</th> <!-- colspan spans 2 columns -->
        </tr>
        <tr>
            <td rowspan="2">Ravi</td> <!-- rowspan spans 2 rows -->
            <td>Maths</td>
            <td>95</td>
        </tr>
        <tr>
            <td>Science</td>
            <td>90</td>
        </tr>
        <tr>
            <td>Sita</td>
            <td>Maths</td>
            <td>88</td>
        </tr>
        <tr>
            <td>Arjun</td>
            <td>Science</td>
            <td>92</td>
        </tr>
    </table>

</body>
</html>
