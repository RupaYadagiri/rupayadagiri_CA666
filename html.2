<!DOCTYPE html>
<html>
<head>
    <title>HTML Hyperlinks Example</title>
</head>
<body>
    <h1>HTML Hyperlinks Demonstration</h1>

    <!-- Simple hyperlink -->
    <h2>Simple Hyperlink</h2>
    <p>
        Visit 
        <a href="https://www.google.com">Google</a>
        to search anything on the internet.
    </p>

    <!-- Hyperlink opening in a new tab -->
    <h2>Hyperlink with target="_blank"</h2>
    <p>
        Visit 
        <a href="https://www.wikipedia.org" target="_blank">Wikipedia</a>
        to read articles. (This link opens in a new tab)
    </p>

    <!-- Hyperlink to another page in the same website -->
    <h2>Hyperlink to internal page</h2>
    <p>
        Go to <a href="about.html">About Us</a> page. (Same website page link)
    </p>

    <!-- Email link -->
    <h2>Email Hyperlink</h2>
    <p>
        Send an email to 
        <a href="mailto:example@example.com">example@example.com</a>
    </p>

    <!-- Telephone link -->
    <h2>Telephone Hyperlink</h2>
    <p>
        Call us at 
        <a href="tel:+911234567890">+91 1234567890</a>
    </p>

    <!-- Link with title attribute -->
    <h2>Hyperlink with title attribute</h2>
    <p>
        Visit 
        <a href="https://www.youtube.com" target="_blank" title="Go to YouTube">
            YouTube
        </a>
    </p>

</body>
</html>
